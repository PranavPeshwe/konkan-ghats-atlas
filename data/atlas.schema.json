{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Konkan atlas snapshot",
  "type": "object",
  "required": ["version", "researchDate", "origin", "ghats", "beaches", "places", "routes", "methodology", "adjacencyGraph"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "researchDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "origin": { "$ref": "#/definitions/place" },
    "places": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/place" } },
    "beaches": { "type": "array", "minItems": 35, "items": {
      "allOf": [
        { "$ref": "#/definitions/place" },
        { "type":"object", "required":["shortestGhatIds","closestGhatRoutes"], "properties":{
          "shortestGhatIds":{"type":"array","minItems":5,"maxItems":5,"uniqueItems":true,"items":{"type":"string"}},
          "closestGhatRoutes":{"type":"array","minItems":5,"maxItems":5,"items":{
            "type":"object","required":["ghatId","routeId","distanceM","comparisonDistanceM"],"properties":{
              "ghatId":{"type":"string"},"routeId":{"type":"string"},
              "distanceM":{"type":"number","exclusiveMinimum":0},"comparisonDistanceM":{"type":"number","exclusiveMinimum":0}
            }
          }}
        }}
      ]
    } },
    "ghats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/definitions/place" },
          {
            "type": "object",
            "required": ["summary", "description", "difficulty", "scenery", "lengthKm", "elevationM", "seasonalNotes", "accessNotes", "waypoints", "claims"],
            "properties": {
              "summary": { "type": "string" },
              "description": { "type": "string" },
              "difficulty": { "$ref": "#/definitions/rating" },
              "scenery": { "$ref": "#/definitions/rating" },
              "lengthKm": { "type": ["number", "null"], "exclusiveMinimum": 0 },
              "elevationM": { "type": ["number", "null"] },
              "seasonalNotes": { "type": "string" },
              "accessNotes": { "type": "string" },
              "waypoints": { "$ref": "#/definitions/ids" },
              "claims": { "type": "object" },
              "nearestBeachIds": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "type": "string" } },
              "closestBeachRoutes": { "type": "array", "minItems": 10, "maxItems": 10, "items": {
                "type": "object", "required": ["beachId", "routeId", "distanceM", "comparisonDistanceM"],
                "properties": {
                  "beachId": { "type": "string" }, "routeId": { "type": "string" },
                  "distanceM": { "type": "number", "exclusiveMinimum": 0 },
                  "comparisonDistanceM": { "type": "number", "exclusiveMinimum": 0 }
                }
              } }
            }
          }
        ]
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "originId", "beachId", "ghatIds", "kind", "waypointIds", "geometry", "distanceKm", "durationHours", "difficulty", "scenery", "tollCostInr", "sourceIds", "provenance"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "originId": { "type": "string" },
          "beachId": { "type": "string" },
          "ghatIds": { "$ref": "#/definitions/ids" },
          "primaryGhatId": { "type": "string" },
          "kind": { "enum": ["ghat", "highway"] },
          "waypointIds": { "$ref": "#/definitions/ids" },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "const": "LineString" },
              "coordinates": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/coordinates" } }
            }
          },
          "distanceKm": { "type": "number", "exclusiveMinimum": 0 },
          "durationHours": { "type": "number", "exclusiveMinimum": 0 },
          "difficulty": { "$ref": "#/definitions/rating" },
          "scenery": { "$ref": "#/definitions/rating" },
          "tollCostInr": { "type": ["number", "null"], "minimum": 0 },
          "sourceIds": { "$ref": "#/definitions/ids" },
          "provenance": { "type": "object" }
        }
      }
    },
    "methodology": { "type": "object" },
    "adjacencyGraph": {
      "type":"object","required":["directed","meaning","routeEdges"],"properties":{
        "directed":{"const":true},"meaning":{"type":"string"},
        "routeEdges":{"type":"array","minItems":1,"items":{
          "type":"object","required":["ghatId","beachId","routeId","distanceM","traversedGhatIds"],"properties":{
            "ghatId":{"type":"string"},"beachId":{"type":"string"},"routeId":{"type":"string"},
            "distanceM":{"type":"number","exclusiveMinimum":0},"traversedGhatIds":{"$ref":"#/definitions/ids"}
          }
        }}
      }
    }
  },
  "definitions": {
    "coordinates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "additionalItems": false
    },
    "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rating": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "place": {
      "type": "object",
      "required": ["id", "name", "coordinates", "sourceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "coordinates": { "$ref": "#/definitions/coordinates" },
        "sourceIds": { "$ref": "#/definitions/ids" },
        "aliases": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
